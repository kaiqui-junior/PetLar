rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function ehDono(uid) {
      return estaLogado() && request.auth.uid == uid;
    }

    function ehAdmin() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function naoEstaBloqueado() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;
    }

    // ---------------- USERS ----------------
    match /users/{userId} {
      allow read: if true; // dados públicos do responsável pelo anúncio (nome/foto)
      allow create: if ehDono(userId);
      // usuário comum não pode alterar 'role' nem 'blocked'; admin pode alterar qualquer coisa
      allow update: if ehAdmin() ||
        (ehDono(userId) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.blocked == resource.data.blocked);
      allow delete: if ehAdmin();
    }

    // ---------------- PETS ----------------
    match /pets/{petId} {
      allow read: if true;
      allow create: if estaLogado() && naoEstaBloqueado() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if ehAdmin() ||
        (estaLogado() && resource.data.ownerId == request.auth.uid);
      allow delete: if ehAdmin() ||
        (estaLogado() && resource.data.ownerId == request.auth.uid);
    }

    // ---------------- ONGS ----------------
    match /ongs/{ongId} {
      allow read: if true;
      allow create: if estaLogado() && naoEstaBloqueado() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if ehAdmin() ||
        (estaLogado() && resource.data.ownerId == request.auth.uid &&
          request.resource.data.status == resource.data.status); // dono não altera status de aprovação
      allow delete: if ehAdmin() ||
        (estaLogado() && resource.data.ownerId == request.auth.uid);
    }

    // ---------------- FAVORITES ----------------
    match /favorites/{favId} {
      allow read: if estaLogado() && resource.data.userId == request.auth.uid;
      allow create: if estaLogado() && request.resource.data.userId == request.auth.uid;
      allow delete: if estaLogado() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ---------------- REPORTS (denúncias) ----------------
    match /reports/{reportId} {
      allow read: if ehAdmin();
      allow create: if estaLogado() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if ehAdmin();
      allow delete: if ehAdmin();
    }
  }
}
